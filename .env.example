# Helm حلم / helm-platform — local development (copy to .env)
# No paid services required for local MVP. Defaults use mocks.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
APP_NAME=Helm حلم
APP_VERSION=0.1.0
API_VERSION=v1

# Postgres (Docker Compose / Supabase local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Auth — mock is local/test only (forbidden when NODE_ENV=production).
# Mock requires SUPABASE_JWT_SECRET (no shared hardcoded secret).
AUTH_PROVIDER=mock
# AUTH_PROVIDER=supabase_jwt

# Supabase local (supabase start) — server-side secrets only
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_AUDIENCE=authenticated
# Optional; defaults to ${SUPABASE_URL}/auth/v1 when SUPABASE_URL is set
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Provider selection — keep mocks for unpaid local MVP
AI_PROVIDER=mock
PAYMENT_PROVIDER=mock
FLIGHT_PROVIDER=mock
NOTIFY_PROVIDER=console

# Apps
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Paid / real providers — REQUIRE Helmy Shehab approval before enabling
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PAYMENT_SECRET_KEY=
# SMS_PROVIDER_API_KEY=
