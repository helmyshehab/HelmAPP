{
  "name": "helm-platform",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "pnpm --filter @helm/openapi codegen && pnpm --filter @helm/api-client-ts codegen && pnpm --filter @helm/api-client-dart codegen",
    "codegen:check": "pnpm codegen && git diff --exit-code -- packages/api-client-ts packages/api-client-dart || (echo 'Generated clients are dirty. Do not hand-edit; regenerate from OpenAPI.' && exit 1)",
    "dataset:ubud:build": "node scripts/build-ubud-dataset-v1.mjs",
    "dataset:ubud:validate": "node scripts/validate-ubud-dataset-v1.mjs",
    "dataset:uluwatu:build": "node scripts/build-uluwatu-dataset-v1.mjs",
    "dataset:uluwatu:validate": "node scripts/validate-uluwatu-dataset-v1.mjs",
    "dataset:canggu:build": "node scripts/build-canggu-dataset-v1.mjs",
    "dataset:canggu:validate": "node scripts/validate-canggu-dataset-v1.mjs",
    "dataset:seminyak:build": "node scripts/build-seminyak-dataset-v1.mjs",
    "dataset:seminyak:validate": "node scripts/validate-seminyak-dataset-v1.mjs",
    "dataset:thailand:build": "node scripts/build-thailand-datasets-v1.mjs",
    "dataset:thailand:validate": "node scripts/validate-thailand-datasets-v1.mjs",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
